sp {elaborate*top-state*top-state
   (state <s> ^superstate nil)
-->
   (<s> ^top-state <s>)
}

sp {elaborate*state*top-state
   (state <s> ^superstate.top-state <ts>)
-->
   (<s> ^top-state <ts>)
}

sp {elaborate*state*item*down
   (state <s> ^superstate.item <i>)
-->
   (<s> ^item <i>)
}

sp {apply*recommend-cafe*send-to-python
   (state <s> ^operator <o>
              ^io.output-link <ol>)
   (<o> ^name recommend-cafe
        ^cafe-name <c-name>)
-->
   (<ol> ^final-recommendation <c-name>)
}

sp {recommend*OPERATOR*주차+공부
   (state <s> ^io.input-link <il>)
   (<il> ^cafe <c>)
   (<c> ^name <c-name> ^keyword << |주차장| |공부| >>)
-->
   (<s> ^operator <o> +)
   (<o> ^name recommend-cafe ^cafe-name <c-name>)
}

sp {recommend*S1*judge*주차+공부
   (state <s> ^operator <o1> +
              ^operator <o2> +
              ^io.input-link <il>)
   (<o1> ^name recommend-cafe ^cafe-name <c1-name>)
   (<o2> ^name recommend-cafe ^cafe-name <c2-name> <> <c1-name>)
   (<il> ^cafe <c1> ^cafe <c2>)
   (<c1> ^name <c1-name> ^keyword |조용한 카페|)
   (<c2> ^name <c2-name>)
   - { (<c2> ^keyword |조용한 카페|) }
-->
   (<s> ^operator <o1> > <o2>)
}

sp {resolve*tie*S2*judge*주차+공부
   (state <s> ^impasse <any-impasse>
              ^superstate <s2>
              ^item <o1> ^item <o2>
              ^top-state <ts>)
   (<s1> ^superstate nil)
   (<s2> ^superstate <s1>)

   (<o1> ^name recommend-cafe ^cafe-name <c1-name>)
   (<o2> ^name recommend-cafe ^cafe-name <c2-name> <> <c1-name>)
   (<ts> ^io.input-link <il>)
   (<il> ^cafe <c1> ^cafe <c2>)
   (<c1> ^name <c1-name> ^keyword |한적한 분위기|)
   (<c2> ^name <c2-name>)
   - { (<c2> ^keyword |한적한 분위기|) }
-->
   (<s1> ^operator <o1> > <o2>)
}

sp {resolve*tie*S3*judge*주차+공부
   (state <s> ^impasse <any-impasse>
              ^superstate <s3>
              ^item <o1> ^item <o2>
              ^top-state <ts>)
   (<s1> ^superstate nil)
   (<s2> ^superstate <s1>)
   (<s3> ^superstate <s2>)

   (<o1> ^name recommend-cafe ^cafe-name <c1-name>)
   (<o2> ^name recommend-cafe ^cafe-name <c2-name> <> <c1-name>)
   (<ts> ^io.input-link <il>)
   (<il> ^cafe <c1> ^cafe <c2>)
   (<c1> ^name <c1-name> ^keyword |독서실모드|)
   (<c2> ^name <c2-name>)
   - { (<c2> ^keyword |독서실모드|) }
-->
   (<s2> ^operator <o1> > <o2>)
}

sp {resolve*tie*S4*judge*주차+공부
   (state <s> ^impasse <any-impasse>
              ^superstate <s4>
              ^item <o1> ^item <o2>
              ^top-state <ts>)
   (<s1> ^superstate nil)
   (<s2> ^superstate <s1>)
   (<s3> ^superstate <s2>)
   (<s4> ^superstate <s3>)

   (<o1> ^name recommend-cafe ^cafe-name <c1-name>)
   (<o2> ^name recommend-cafe ^cafe-name <c2-name> <> <c1-name>)
   (<ts> ^io.input-link <il>)
   (<il> ^cafe <c1> ^cafe <c2>)
   (<c1> ^name <c1-name> ^keyword |콘센트|)
   (<c2> ^name <c2-name>)
   - { (<c2> ^keyword |콘센트|) }
-->
   (<s3> ^operator <o1> > <o2>)
}

sp {resolve*tie*S5*judge*주차+공부
   (state <s> ^impasse <any-impasse>
              ^superstate <s5>
              ^item <o1> ^item <o2>
              ^top-state <ts>)
   (<s1> ^superstate nil)
   (<s2> ^superstate <s1>)
   (<s3> ^superstate <s2>)
   (<s4> ^superstate <s3>)
   (<s5> ^superstate <s4>)

   (<o1> ^name recommend-cafe ^cafe-name <c1-name>)
   (<o2> ^name recommend-cafe ^cafe-name <c2-name> <> <c1-name>)
   (<ts> ^io.input-link <il>)
   (<il> ^cafe <c1> ^cafe <c2>)
   (<c1> ^name <c1-name> ^keyword |집중도|)
   (<c2> ^name <c2-name>)
   - { (<c2> ^keyword |집중도|) }
-->
   (<s4> ^operator <o1> > <o2>)
}

sp {resolve*tie*S6*ask-llm*주차+공부
   (state <s> ^impasse <any-impasse>
              ^superstate <s6>
              ^item <o1> ^item <o2>
              ^top-state <ts>)
   (<s1> ^superstate nil)
   (<s2> ^superstate <s1>)
   (<s3> ^superstate <s2>)
   (<s4> ^superstate <s3>)
   (<s5> ^superstate <s4>)
   (<s6> ^superstate <s5>)

   (<o1> ^cafe-name <c1-name>)
   (<o2> ^cafe-name { <c2-name> <> <c1-name> })
   (<ts> ^io.output-link <ol>)
-->
   (<ol> ^ask-llm <req>)
   (<req> ^cand1 <c1-name>
          ^cand2 <c2-name>
          ^stopped-depth 6)
}
