# 이 파일을 .env로 복사해서 값을 채우세요:  cp .env.example .env
# (.env는 .gitignore라 커밋되지 않습니다)

# ── 필수 ─────────────────────────────────────────────
# OpenAI — 질문 분류 / impasse 해소 / 최종 답변 생성
OPENAI_API_KEY=sk-...

# HuggingFace read 토큰 — BGE-M3 임베딩 / sLLM gguf 다운로드
HUGGINGFACE_TOKEN_READ=hf_...

# OpenSearch — rule 벡터 검색 (docker-compose가 이 값으로 컨테이너를 띄움)
# 2.13은 강한 비밀번호 요구: 대/소문자 + 숫자 + 특수문자
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Cafe!Search2024

# 앱 → 모델 추론 서버 주소 (로컬은 그대로, GPU 배포 시 Modal 등 주소로 교체)
MODEL_SERVER_URL=http://localhost:8001

# ── 선택 (없어도 동작) ───────────────────────────────
# HuggingFace write — 모델 업로드(upload.py) 시에만 필요
HUGGINGFACE_TOKEN_WRITE=hf_...

# Langfuse — LLM 관측성(트레이싱). 없으면 추적만 비활성, 추천은 정상 동작
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
